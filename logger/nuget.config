<?xml version="1.0" encoding="utf-8"?>
<!-- Pin the package source so the logger builds the same on every machine and in CI,
     whatever sources the machine-wide NuGet config has. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
